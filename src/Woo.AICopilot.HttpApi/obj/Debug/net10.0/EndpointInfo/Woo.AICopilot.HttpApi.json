  "components": {
    "schemas": {
      "ChatStreamRequest": {
        "required": [
          "sessionId",
          "message",
          "callIds"
        ],
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string"
          },
          "callIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateConversationTemplateCommand": {
        "required": [
          "name",
          "description",
          "systemPrompt",
          "modelId",
          "maxTokens",
          "temperature"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "systemPrompt": {
            "type": "string"
          },
          "modelId": {
            "type": "string",
            "format": "uuid"
          },
          "maxTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "temperature": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "float"
          }
        }
      },
      "CreateKnowledgeBaseCommand": {
        "required": [
          "name",
          "description",
          "embeddingModelId"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "embeddingModelId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateLanguageModelCommand": {
        "required": [
          "provider",
          "name",
          "baseUrl",
          "apiKey",
          "maxTokens"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "apiKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "maxTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "temperature": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "float",
            "default": 0.7
          }
        }
      },
      "CreateRoleRequest": {
        "required": [
          "roleName"
        ],
        "type": "object",
        "properties": {
          "roleName": {
            "type": "string"
          }
        }
      },
      "CreateSessionCommand": {
        "required": [
          "templateId"
        ],
        "type": "object",
        "properties": {
          "templateId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "DeleteConversationTemplateCommand": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DeleteLanguageModelCommand": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DeleteSessionCommand": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetConversationTemplateQuery": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "SearchKnowledgeBaseQuery": {
        "required": [
          "knowledgeBaseId",
          "queryText"
        ],
        "type": "object",
        "properties": {
          "knowledgeBaseId": {
            "type": "string",
            "format": "uuid"
          },
          "queryText": {
            "type": "string"
          },
          "topK": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 3
          },
          "minScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double",
            "default": 0.5
          }
        }
      },
      "UserLoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UserRegisterRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      }
    }
  },
